<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="faqScrollPane" fitToWidth="true" style="-fx-background-color: #f0f4f7;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1">
    <content>
        <VBox alignment="CENTER" spacing="15">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <!-- Title -->
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text=" FAQ" />

            <!-- Wrap cards in a FlowPane so they sit side-by-side -->
            <FlowPane alignment="CENTER" hgap="20" vgap="20">
                <children>

                    <!-- Card: Login Info -->
                    <VBox alignment="TOP_LEFT" prefHeight="110.0" prefWidth="250" spacing="8" style="-fx-background-color: linear-gradient(to bottom right, #A8E6CF, #DCEDC1);                                  -fx-border-color: #c0c0c0;                                  -fx-border-radius: 10; -fx-background-radius: 10;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,3);">
                        <padding>
                            <Insets bottom="10" left="12" right="12" top="10" />
                        </padding>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Login Information" />
                        <Label text="Allows login for Admin, Manager, and User (Housekeeper, Maintenance, Food Worker)." wrapText="true" />
                    </VBox>

                    <!-- Card: Admin Info -->
                    <VBox alignment="TOP_LEFT" prefHeight="105.0" prefWidth="250" spacing="8" style="-fx-background-color: linear-gradient(to bottom right, #FFD3B6, #FFAAA5);                                  -fx-border-color: #c0c0c0;                                  -fx-border-radius: 10; -fx-background-radius: 10;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,3);">
                        <padding>
                            <Insets bottom="10" left="12" right="12" top="10" />
                        </padding>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Admin Privileges" />
                        <Label text="Admins can edit users, manage accounts, and print summaries or reports." wrapText="true" />
                    </VBox>

                    <!-- Card: Manager Info -->
                    <VBox alignment="TOP_LEFT" prefHeight="90.0" prefWidth="250" spacing="8" style="-fx-background-color: linear-gradient(to bottom right, #FFECB3, #FFE082);                                  -fx-border-color: #c0c0c0;                                  -fx-border-radius: 10; -fx-background-radius: 10;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,3);">
                        <padding>
                            <Insets bottom="10" left="12" right="12" top="10" />
                        </padding>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Manager Privileges" />
                        <Label text="Managers can add guests, handle reservations, and view payment history." wrapText="true" />
                    </VBox>

                    <!-- Card: User Info -->
                    <VBox alignment="TOP_LEFT" prefHeight="86.0" prefWidth="250" spacing="8" style="-fx-background-color: linear-gradient(to bottom right, #B3E5FC, #81D4FA);                                  -fx-border-color: #c0c0c0;                                  -fx-border-radius: 10; -fx-background-radius: 10;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,3);">
                        <padding>
                            <Insets bottom="10" left="12" right="12" top="10" />
                        </padding>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="User Privileges" />
                        <Label text="Users can view shifts, track hours, and access their schedules (read-only)." wrapText="true" />
                    </VBox>

                    <!-- Card: Booking & Payments -->
                    <VBox alignment="TOP_LEFT" prefHeight="85.0" prefWidth="250" spacing="8" style="-fx-background-color: linear-gradient(to bottom right, #D1C4E9, #B39DDB);                                  -fx-border-color: #c0c0c0;                                  -fx-border-radius: 10; -fx-background-radius: 10;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,3);">
                        <padding>
                            <Insets bottom="10" left="12" right="12" top="10" />
                        </padding>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Booking &amp; Payments" />
                        <Label text="Managers record bookings and payments; admins print payment reports." wrapText="true" />
                    </VBox>

                    <!-- Card: How to Use -->
                    <VBox alignment="TOP_LEFT" prefHeight="91.0" prefWidth="250" spacing="8" style="-fx-background-color: linear-gradient(to bottom right, #FFCCBC, #FFAB91);                                  -fx-border-color: #c0c0c0;                                  -fx-border-radius: 10; -fx-background-radius: 10;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,3);">
                        <padding>
                            <Insets bottom="10" left="12" right="12" top="10" />
                        </padding>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="How to Use the Program" />
                        <Label text="Login, navigate menus, manage users or bookings, and always log out after use." wrapText="true" />
                    </VBox>

                    <!-- Card: Notes -->
                    <VBox alignment="TOP_LEFT" prefHeight="89.0" prefWidth="250" spacing="8" style="-fx-background-color: linear-gradient(to bottom right, #C8E6C9, #A5D6A7);                                  -fx-border-color: #c0c0c0;                                  -fx-border-radius: 10; -fx-background-radius: 10;                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,3);">
                        <padding>
                            <Insets bottom="10" left="12" right="12" top="10" />
                        </padding>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Additional Notes" />
                        <Label text="Always log out. The system auto-updates room availability and staff schedules." wrapText="true" />
                    </VBox>

                </children>
            </FlowPane>
        </VBox>
    </content>
</ScrollPane>
