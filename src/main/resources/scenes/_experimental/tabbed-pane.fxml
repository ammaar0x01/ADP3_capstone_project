                        <VBox prefHeight="450.0" prefWidth="1000.0">
                           <children>
                              <Label prefWidth="1000.0" text="Home">
                                 <font>
                                    <Font name="Century" size="30.0" />
                                 </font>
                                 <VBox.margin>
                                    <Insets bottom="10.0" left="20.0" right="10.0" top="20.0" />
                                 </VBox.margin>
                              </Label>
                              <HBox prefHeight="300.0" prefWidth="200.0">
                                 <children>
                                    <GridPane prefWidth="500.0">
                                      <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
