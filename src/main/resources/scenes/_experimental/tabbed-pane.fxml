   <top>
      <Pane prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: black;" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="1000.0">
               <children>
                  <Label alignment="CENTER" text="Jazzy Joint" textAlignment="CENTER" textFill="WHITE">
                     <font>
                        <Font name="Californian FB" size="30.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </children>
      </Pane>
