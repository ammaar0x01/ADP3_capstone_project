<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.college.controller.employeeRelated.EmployeeUIController">
   <center>
      <Pane prefHeight="600.0" BorderPane.alignment="CENTER">
         <children>
            <HBox prefHeight="600.0">
               <children>
               
                   <!-- Side Pane -->
                   <Pane prefWidth="200.0" style="-fx-background-color: black;">
                       <children>
                        <VBox alignment="CENTER" prefHeight="600.0" prefWidth="200.0">
                           <children>
                     
                                 <!-- Buttons -->
                     <!--            <Button layoutX="41.0" layoutY="193.0" prefHeight="40.0" prefWidth="150.0"-->
                     <!--                    style="-fx-background-color: #398F6C;-fx-background-radius: 15px;"-->
                     <!--                    stylesheets="/css/buttonStyle.css" text="Add Employee"-->
                     <!--                    textFill="WHITE" onAction="#addEmployee"/>-->
                     
                                 <Button alignment="CENTER" contentDisplay="CENTER" onAction="#updateEmployee" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: white;" stylesheets="/css/buttonStyle.css" text="Update Employee">
                                 <VBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </VBox.margin>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                                 <font>
                                    <Font name="Bell MT Italic" size="14.0" />
                                 </font>
                              </Button>
                              <Button alignment="CENTER" contentDisplay="CENTER" onAction="#updateEmployee" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: transparent; -fx-border-color: red;" stylesheets="/css/buttonStyle.css" text="Go back" textFill="#fa4419">
                                 <VBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </VBox.margin>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                                 <font>
                                    <Font name="Bell MT Italic" size="14.0" />
                                 </font>
                              </Button>
                           </children>
                        </VBox>
               
               <!--            <Button layoutX="40.0" layoutY="350.0" prefHeight="40.0" prefWidth="150.0"-->
               <!--                    style="-fx-background-color: #E02850;-fx-background-radius: 15px;"-->
               <!--                    stylesheets="/css/buttonStyle.css" text="Delete Employee"-->
               <!--                    textFill="WHITE" onAction="#deleteEmployee"/>-->
                       </children>
                   </Pane>

                   <!-- Main Pane -->
<!--                   style="-fx-background-color: linear-gradient(to left, orange, black);"-->
                   <Pane prefWidth="800.0" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, orange, black);">
                     <children>
                        <VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="800.0">
                           <children>
                              <Text fill="WHITE" fontSmoothingType="LCD" strokeType="OUTSIDE" strokeWidth="0.0" text="Employees" textAlignment="CENTER">
                                 <font>
                                    <Font name="Bell MT Italic" size="50.0" />
                                 </font>
                                 <VBox.margin>
                                    <Insets bottom="30.0" left="10.0" right="10.0" top="10.0" />
                                 </VBox.margin>
                              </Text>
                           
                               <!-- Table -->
                               <TableView fx:id="employeeTable" prefHeight="400.0" prefWidth="500.0" style="-fx-background-color: transparent;">
                                   <columns>
                                       <TableColumn fx:id="colEmployeeId" editable="false" maxWidth="250.0" minWidth="100.0" prefWidth="170.0" style="-fx-background-color: transparent;" text="Employee Id" />
                                       <TableColumn fx:id="colJobType" editable="false" maxWidth="250.0" minWidth="100.0" prefWidth="170.0" style="-fx-background-color: transparent;" text="Job Type" />
                                       <TableColumn fx:id="colStartDate" editable="false" maxWidth="250.0" minWidth="100.0" prefWidth="170.0" style="-fx-background-color: transparent;" text="Start Date" />
                                       <TableColumn fx:id="colUserId" editable="false" maxWidth="250.0" minWidth="100.0" prefWidth="170.0" style="-fx-background-color: transparent;" text="User Id" />
                                   </columns>
                               </TableView>
                           </children>
                           <padding>
                              <Insets bottom="30.0" left="20.0" right="20.0" top="30.0" />
                           </padding>
                        </VBox>
                     </children>
                  </Pane>
               </children>
            </HBox>
         </children>
      </Pane>
   </center>
</BorderPane>
