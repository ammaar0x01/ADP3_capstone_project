                            </padding>
                        </Label>
                  </children>
               </VBox>
      
              </children>
          </Pane>
         <BorderPane prefWidth="800.0">
            <top>
               <VBox BorderPane.alignment="CENTER">
                  <children>
                  
                      <!-- Title -->
                      <Text fill="#383838" strokeType="OUTSIDE" strokeWidth="0.0" text="Users" wrappingWidth="188.34881591796875">
