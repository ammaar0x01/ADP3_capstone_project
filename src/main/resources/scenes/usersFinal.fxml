<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.college.controller.UserTableController">
   <HBox layoutX="-7.0" layoutY="-1.0">
      <children>
      
          <!-- Side Pane with Buttons -->
          <Pane prefHeight="600.0" prefWidth="200.0" style="-fx-background-color: #45b6fe;">
              <children>
               <VBox layoutX="10.0" layoutY="26.0" prefHeight="450.0" prefWidth="210.0">
                  <children>
                        <ImageView>
                            <image>
                                <Image url="@../images/c.png" />
            <!--                    <Image url="@images/c.png" />-->
            
                            </image>
                        <VBox.margin>
                           <Insets bottom="100.0" left="10.0" right="10.0" top="10.0" />
                        </VBox.margin>
                        </ImageView>
            
                        <!-- might need this later, if we don't want everyone creating employees-->
            <!--            <Button layoutX="40.0" layoutY="193.0" fx:id="btnAdd" onAction="#addUser"-->
            <!--                    prefHeight="40.0" prefWidth="150.0"-->
            <!--                    style="-fx-background-color: #398F6C; -fx-background-radius: 15px;"-->
            <!--                    stylesheets="/css/buttonStyle.css"-->
            <!--                    text="Add User" textFill="WHITE"/>-->
            
            <!--            <Button layoutX="40.0" layoutY="275.0" fx:id="btnEdit" onAction="#updateUser"-->
                        <Button fx:id="btnEdit" onAction="#updateEmployee" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #2fa0e8; -fx-background-radius: 15px;" stylesheets="/css/buttonStyle.css" text="Update User" textFill="WHITE">
                        <VBox.margin>
                           <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </VBox.margin>
                     </Button>
            
                        <Button fx:id="btnDelete" onAction="#deleteUser" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #E02850; -fx-background-radius: 15px;" stylesheets="/css/buttonStyle.css" text="Delete User" textFill="WHITE">
