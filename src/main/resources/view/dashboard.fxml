<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.college.controller.DashboardController">

    <left>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox prefWidth="220" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
                <!-- User Profile -->
                <VBox spacing="10" alignment="CENTER">
                    <Label text="👤" style="-fx-text-fill: white; -fx-font-size: 40px;" />
                    <Label text="John Doe" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
                    <Label text="Administrator" style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;" />
                </VBox>

                <Separator />

                <!-- Menu Items with CSS Classes -->
                <VBox spacing="5">
                    <Button text="Overview" onAction="#showHome" styleClass="menu-button" />
                    <Button text="Guests" onAction="#showGuests" styleClass="menu-button" />
                    <Button text="Events" onAction="#showEvents" styleClass="menu-button" />
                    <Button text="Payments" onAction="#showPayments" styleClass="menu-button" />
                    <Button text="Employees" onAction="#showEmployees" styleClass="menu-button" />
                    <Button text="Rooms" onAction="#showRooms" styleClass="menu-button" />
                    <Button text="Venues" onAction="#showVenues" styleClass="menu-button" />
                </VBox>

                <!-- Spacer to push exit button down -->
                <Region VBox.vgrow="ALWAYS" />

                <!-- Centered Exit Button with CSS Class -->
                <VBox alignment="CENTER" spacing="10">
                    <Separator />
                    <Button text="Exit" onAction="#exitApplication" styleClass="exit-button" />
                </VBox>
            </VBox>
        </ScrollPane>
    </left>

    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #ecf0f1;" />
    </center>
</BorderPane>